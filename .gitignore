.env
.env.*
!.env.example
*.key
credentials.json
client_secret*.json


data/raw/*
data/processed/*
data/interim/*
*.jsonl
*.csv
# Allow version-controlled documentation templates
!docs/collection_coverage_template.csv
!docs/data_handoff_manifest_template.csv
!docs/query_execution_audit_template.csv
!docs/schema_mapping_template.csv

# The real handoff manifest is a small, hand-maintained provenance/audit
# deliverable (checklist.md final output #1), not raw scraped data — track it.
!docs/data_handoff_manifest.csv

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep
!**/sample_*.csv
!**/sample_*.jsonl

__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

outputs/*
!outputs/.gitkeep
!outputs/figures/
!outputs/figures/.gitkeep
!outputs/tables/
!outputs/tables/.gitkeep
!outputs/audits/
!outputs/audits/.gitkeep
!outputs/model_evaluation/
!outputs/model_evaluation/.gitkeep
.ipynb_checkpoints/

# raw_original platform data — large binary/CSV files stay local, only README is tracked
data/raw_original/x/
data/raw_original/reddit/
data/raw_original/youtube/
data/raw_original/financial/

# Public, frozen financial inputs are intentionally versioned so the
# financial notebooks can be reproduced without repeating web collection.
!data/interim/financial/
!data/interim/financial/frozen_inputs/
!data/interim/financial/frozen_inputs/*.csv

# Small, reviewable financial tables and audits are project deliverables.
!outputs/tables/financial/
!outputs/tables/financial/*.csv
!outputs/audits/financial/
!outputs/audits/financial/*.csv
!outputs/audits/financial/*.txt

data_backup/

.claude/settings.local.json

